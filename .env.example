# Career Automator Environment Configuration (Template)
# Copy this file to .env and insert your real credentials

# Gemini API Keys (Get free keys at https://aistudio.google.com/)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# NVIDIA / DeepSeek API (Optional fallback reasoning model)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Chrome Remote Debugging
CHROME_CDP_URL=http://localhost:9222
CHROME_USER_DATA_DIR=~/.chrome-job-agent

# Automation Parameters
MAX_APPLICATIONS_PER_RUN=10
MIN_ACTION_DELAY=1.5
MAX_ACTION_DELAY=2.8
DEFAULT_LOCATION="Bengaluru, Karnataka, India"
DEFAULT_WORK_MODE=remote_first
